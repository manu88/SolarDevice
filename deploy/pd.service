[Unit]
Description=PureData
After=network.target

[Service]
Type=simple
Nice=-20
ExecStartPre=amixer -c 3 set Master 60%
ExecStart=pd -nogui main_audio.pd  -path /home/solar/
Restart=on-failure
RestartSec=10s
User=solar
WorkingDirectory=/home/solar/SolarDevice/Pd
StandardOutput=journal
StandardError=journal


[Install]
WantedBy=multi-user.target
